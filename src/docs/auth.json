{
  "/auth/signup": {
    "post": {
      "summary": "Registra um novo usuário comum no sistema",
      "tags": ["Autenticação & Setup"],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "name",
                "username",
                "email",
                "password",
                "passwordConfirm"
              ],
              "properties": {
                "name": { "type": "string", "example": "User" },
                "username": { "type": "string", "example": "user" },
                "email": { "type": "string", "example": "user@exemplo.com" },
                "phone": {
                  "type": "string",
                  "example": "+5518999999999",
                  "description": "Telefone opcional formatado com DDD."
                },
                "password": { "type": "string", "example": "root" },
                "passwordConfirm": { "type": "string", "example": "root" }
              }
            }
          }
        }
      },
      "responses": {
        "201": { "description": "Usuário criado com sucesso e autenticado." },
        "400": {
          "description": "Erro de validação ou e-mail/username já em uso."
        }
      }
    }
  },
  "/auth/signin": {
    "post": {
      "summary": "Autentica um usuário (via e-mail ou username)",
      "tags": ["Autenticação & Setup"],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["username", "password"],
              "properties": {
                "username": { "type": "string", "example": "root" },
                "password": { "type": "string", "example": "root" }
              }
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Login efetuado com sucesso. Retorna Access Token e define cookies securitizados."
        },
        "401": { "description": "Credenciais inválidas." }
      }
    }
  },
  "/auth/refresh": {
    "post": {
      "summary": "Renova o Access Token expirado usando o Refresh Token guardado nos Cookies ou Body",
      "tags": ["Autenticação & Setup"],
      "requestBody": {
        "required": false,
        "description": "Opcional se enviado via Cookies HttpOnly, útil para testes diretos no Swagger UI.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "refreshToken": {
                  "type": "string",
                  "example": "4a1b9-9bc90e940023-65b8f13e",
                  "description": "Token de renovação de sessão de longo prazo."
                }
              }
            }
          }
        }
      },
      "responses": {
        "200": { "description": "Token renovado com sucesso." },
        "401": { "description": "Sessão expirada ou Refresh Token inválido." }
      }
    }
  },
  "/auth/signout": {
    "post": {
      "summary": "Encerra a sessão atual limpando os cookies e invalidando o token no banco",
      "tags": ["Autenticação & Setup"],
      "responses": {
        "200": { "description": "Logout concluído com sucesso." }
      }
    }
  },
  "/auth/forgot-password": {
    "post": {
      "summary": "Solicita a recuperação de senha enviando um token OTP por e-mail",
      "tags": ["Autenticação & Setup"],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["identifier"],
              "properties": {
                "identifier": {
                  "type": "string",
                  "example": "root@gmail.com",
                  "description": "Pode ser informado o e-mail ou o username do usuário cadastrado."
                }
              }
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "E-mail de recuperação enviado (se o usuário existir)."
        }
      }
    }
  },
  "/auth/reset-password": {
    "post": {
      "summary": "Redefine a senha do usuário utilizando o token OTP recebido por e-mail",
      "tags": ["Autenticação & Setup"],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["token", "password", "passwordConfirm"],
              "properties": {
                "token": {
                  "type": "string",
                  "example": "123456",
                  "description": "Código OTP numérico estável de exatamente 6 dígitos."
                },
                "password": { "type": "string", "example": "root1" },
                "passwordConfirm": { "type": "string", "example": "root1" }
              }
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Senha redefinida com sucesso. Nova sessão iniciada."
        },
        "400": {
          "description": "Token inválido, expirado ou divergência na confirmação de senha."
        }
      }
    }
  },
  "/auth/setup": {
    "get": {
      "summary": "Verifica o status de inicialização do sistema",
      "description": "Retorna se o usuário administrador ROOT já foi configurado ou se o sistema está aberto para a execução do setup inicial.",
      "tags": ["Autenticação & Setup"],
      "responses": {
        "200": {
          "description": "Status do sistema verificado com sucesso.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": { "type": "string", "example": "success" },
                  "message": {
                    "type": "string",
                    "example": "Nenhum administrador encontrado. Redirecionar para registro."
                  },
                  "data": {
                    "type": "object",
                    "properties": {
                      "inicializado": { "type": "boolean", "example": false }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "post": {
      "summary": "Inicializa o primeiro usuário administrador ROOT",
      "description": "Cria o primeiro usuário do sistema com a role ROOT. Esta operação só é permitida se nenhum usuário existir no banco de dados.",
      "tags": ["Autenticação & Setup"],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "name",
                "username",
                "email",
                "password",
                "passwordConfirm"
              ],
              "properties": {
                "name": { "type": "string", "example": "Root User" },
                "username": { "type": "string", "example": "root" },
                "email": { "type": "string", "example": "root@gmail.com" },
                "phone": {
                  "type": "string",
                  "example": "+5518999999999",
                  "description": "Telefone opcional de contato do ROOT."
                },
                "password": { "type": "string", "example": "root" },
                "passwordConfirm": {
                  "type": "string",
                  "example": "root"
                }
              }
            }
          }
        }
      },
      "responses": {
        "201": {
          "description": "Usuário ROOT inicializado com sucesso.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": { "type": "string", "example": "success" },
                  "message": {
                    "type": "string",
                    "example": "Primeiro administrador criado com sucesso!"
                  },
                  "data": {
                    "type": "object",
                    "properties": {
                      "id": { "type": "integer", "example": 1 },
                      "name": { "type": "string", "example": "Root User" },
                      "username": { "type": "string", "example": "root" },
                      "email": {
                        "type": "string",
                        "example": "root@gmail.com"
                      },
                      "role": { "type": "string", "example": "ROOT" }
                    }
                  }
                }
              }
            }
          }
        },
        "400": {
          "description": "Erro de validação ou o usuário ROOT já foi configurado previamente.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": { "type": "string", "example": "fail" },
                  "message": {
                    "type": "string",
                    "example": "O usuário ROOT já foi configurado previamente."
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
