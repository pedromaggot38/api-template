{
  "/auth/signup": {
    "post": {
      "summary": "Registra um novo usuário comum no sistema",
      "tags": ["Autenticação & Setup"],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "name",
                "username",
                "email",
                "password",
                "passwordConfirm"
              ],
              "properties": {
                "name": { "type": "string", "example": "User" },
                "username": { "type": "string", "example": "user" },
                "email": { "type": "string", "example": "user@exemplo.com" },
                "password": { "type": "string", "example": "root" },
                "passwordConfirm": { "type": "string", "example": "root" }
              }
            }
          }
        }
      },
      "responses": {
        "201": { "description": "Usuário criado com sucesso e autenticado." },
        "400": {
          "description": "Erro de validação ou e-mail/username já em uso."
        }
      }
    }
  },
  "/auth/signin": {
    "post": {
      "summary": "Autentica um usuário (via e-mail ou username)",
      "tags": ["Autenticação & Setup"],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["identifier", "password"],
              "properties": {
                "identifier": { "type": "string", "example": "root" },
                "password": { "type": "string", "example": "root" }
              }
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Login efetuado com sucesso. Retorna Access Token e define cookies securitizados."
        },
        "401": { "description": "Credenciais inválidas." }
      }
    }
  },
  "/auth/refresh": {
    "post": {
      "summary": "Renova o Access Token expirado usando o Refresh Token guardado nos Cookies",
      "tags": ["Autenticação & Setup"],
      "responses": {
        "200": { "description": "Token renovado com sucesso." },
        "401": { "description": "Sessão expirada ou Refresh Token inválido." }
      }
    }
  },
  "/auth/signout": {
    "post": {
      "summary": "Encerra a sessão atual limpando os cookies e invalidando o token no banco",
      "tags": ["Autenticação & Setup"],
      "responses": {
        "200": { "description": "Logout concluído com sucesso." }
      }
    }
  },
  "/auth/forgot-password": {
    "post": {
      "summary": "Solicita a recuperação de senha enviando um token OTP por e-mail",
      "tags": ["Autenticação & Setup"],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["email"],
              "properties": {
                "email": { "type": "string", "example": "root@gmail.com" }
              }
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "E-mail de recuperação enviado (se o usuário existir)."
        }
      }
    }
  },
  "/auth/reset-password": {
    "post": {
      "summary": "Redefine a senha do usuário utilizando o token OTP recebido por e-mail",
      "tags": ["Autenticação & Setup"],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["email", "token", "password", "passwordConfirm"],
              "properties": {
                "token": { "type": "string", "example": "123456" },
                "password": { "type": "string", "example": "root1" },
                "passwordConfirm": {
                  "type": "string",
                  "example": "root1"
                }
              }
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Senha redefinida com sucesso. Nova sessão iniciada."
        },
        "400": {
          "description": "Token inválido, expirado ou divergência na confirmação de senha."
        }
      }
    }
  },
  "/auth/setup/status": {
    "get": {
      "summary": "Verifica se o sistema já possui um usuário administrador ROOT configurado",
      "tags": ["Autenticação & Setup"],
      "responses": {
        "200": {
          "description": "Retorna se o ROOT já foi criado ou se o sistema está aberto para setup."
        }
      }
    }
  },
  "/auth/setup/root": {
    "post": {
      "summary": "Inicializa o primeiro usuário do sistema com a role ROOT (Só funciona se nenhum usuário existir)",
      "tags": ["Autenticação & Setup"],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "name",
                "username",
                "email",
                "password",
                "passwordConfirm"
              ],
              "properties": {
                "name": { "type": "string", "example": "Root User" },
                "username": { "type": "string", "example": "root" },
                "email": { "type": "string", "example": "root@gmail.com" },
                "password": { "type": "string", "example": "root" },
                "passwordConfirm": {
                  "type": "string",
                  "example": "root"
                }
              }
            }
          }
        }
      },
      "responses": {
        "201": { "description": "Usuário ROOT inicializado com sucesso." },
        "400": {
          "description": "O usuário ROOT já foi configurado previamente."
        }
      }
    }
  }
}
