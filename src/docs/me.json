{
  "/me": {
    "get": {
      "summary": "Busca o perfil completo do usuário autenticado",
      "tags": ["Meu Perfil (Me)"],
      "security": [{ "bearerAuth": [] }],
      "responses": {
        "200": { "description": "Dados do perfil retornados com sucesso." },
        "401": { "description": "Não autenticado." }
      }
    },
    "patch": {
      "summary": "Atualiza dados do perfil (Suporta Upload de Arquivo OU URL de imagem + Campos do Schema)",
      "tags": ["Meu Perfil (Me)"],
      "security": [{ "bearerAuth": [] }],
      "requestBody": {
        "required": true,
        "content": {
          "multipart/form-data": {
            "schema": {
              "type": "object",
              "properties": {
                "avatar": {
                  "type": "string",
                  "format": "binary",
                  "description": "Selecione um arquivo físico de imagem (JPEG, PNG, WEBP) de até 2MB."
                },
                "name": {
                  "type": "string",
                  "example": "root user",
                  "description": "Nome completo do usuário."
                },
                "username": {
                  "type": "string",
                  "example": "root",
                  "description": "Nome de usuário único para identificação na plataforma."
                }
              }
            }
          },
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "avatar": {
                  "type": "string",
                  "example": "https://avatars.githubusercontent.com/u/123456",
                  "description": "Cole aqui a URL externa direta de uma imagem da internet."
                },
                "name": {
                  "type": "string",
                  "example": "root user"
                },
                "username": {
                  "type": "string",
                  "example": "root"
                }
              }
            }
          }
        }
      },
      "responses": {
        "200": { "description": "Perfil e avatar atualizados com sucesso." },
        "400": {
          "description": "Erro de validação nos campos enviados ou payload vazio."
        },
        "401": { "description": "Token JWT ausente ou inválido." }
      }
    }
  },
  "/me/password": {
    "patch": {
      "summary": "Altera a senha do usuário de dentro da sua sessão ativa",
      "tags": ["Meu Perfil (Me)"],
      "security": [{ "bearerAuth": [] }],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["currentPassword", "password", "passwordConfirm"],
              "properties": {
                "currentPassword": {
                  "type": "string",
                  "example": "root"
                },
                "password": {
                  "type": "string",
                  "example": "newroot"
                },
                "passwordConfirm": {
                  "type": "string",
                  "example": "newroot"
                }
              }
            }
          }
        }
      },
      "responses": {
        "200": { "description": "Senha atualizada com sucesso." }
      }
    }
  },
  "/me/request-token": {
    "post": {
      "summary": "Gera e envia um novo token OTP para validação da conta do usuário logado",
      "tags": ["Meu Perfil (Me)"],
      "security": [{ "bearerAuth": [] }],
      "responses": {
        "200": {
          "description": "Token de ativação disparado para o e-mail cadastrado."
        }
      }
    }
  },
  "/me/verify-token": {
    "post": {
      "summary": "Consome o token OTP recebido para confirmar e ativar a conta permanentemente",
      "tags": ["Meu Perfil (Me)"],
      "security": [{ "bearerAuth": [] }],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["token"],
              "properties": {
                "token": { "type": "string", "example": "987654" }
              }
            }
          }
        }
      },
      "responses": {
        "200": { "description": "Conta verificada com sucesso." }
      }
    }
  },
  "/me/change-email/request": {
    "post": {
      "summary": "Inicia a troca de e-mail enviando um token de aprovação para o NOVO e-mail solicitado",
      "tags": ["Meu Perfil (Me)"],
      "security": [{ "bearerAuth": [] }],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["newEmail"],
              "properties": {
                "newEmail": {
                  "type": "string",
                  "example": "newemail@exemplo.com"
                }
              }
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Token de segurança enviado ao novo endereço eletrônico informado."
        }
      }
    }
  },
  "/me/change-email/verify": {
    "post": {
      "summary": "Valida o token enviado ao novo endereço e consolida a troca do e-mail no perfil",
      "tags": ["Meu Perfil (Me)"],
      "security": [{ "bearerAuth": [] }],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["token"],
              "properties": {
                "token": { "type": "string", "example": "123789" }
              }
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "E-mail atualizado com sucesso no banco de dados."
        }
      }
    }
  },
  "/me/deactivate": {
    "patch": {
      "summary": "Desativa temporariamente a conta do usuário autenticado mediante confirmação de senha",
      "tags": ["Meu Perfil (Me)"],
      "security": [{ "bearerAuth": [] }],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["password"],
              "properties": {
                "password": {
                  "type": "string",
                  "example": "Senha@123",
                  "description": "A senha atual do usuário para confirmar a reautenticação."
                }
              }
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Conta desativada e cookies de sessão limpos com sucesso."
        },
        "401": {
          "description": "Senha incorreta ou token inválido."
        }
      }
    }
  }
}
