# Variáveis para o container do Postgres (Desenvolvimento)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=mydb

# URL Prisma
DATABASE_URL="postgresql://postgres:password@db:5432/mydb?schema=public"

FRONTEND_URL=https://seu-site.com.br

PORT=3000
NODE_ENV=development

# Configurações de JWT
JWT_ACCESS_SECRET="sua_chave_secreta_de_acesso_muito_segura"
JWT_ACCESS_EXPIRES_IN="15m"

JWT_REFRESH_SECRET="sua_chave_secreta_de_refresh_super_segura"
JWT_REFRESH_EXPIRES_IN="7d"
JWT_REFRESH_COOKIE_EXPIRES_IN=7

# Configurações de placeholder nos templates de email
COMPANY_NAME="Sua Empresa Ltda"
SYSTEM_NAME="Sistema de Gestão"
EMAIL_HEADER_TITLE="Sistema de Template"

# Configurações de provedor de envio de emails
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=seu_email_no_brevo@exemplo.com
SMTP_PASS=sua_chave_smtp_gerada_no_painel
EMAIL_FROM="API Template <email-cadastrado-no-provedor-de-envio-de-email@mail.com>"